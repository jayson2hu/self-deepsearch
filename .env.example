APP_ENV=development
BUILD_VERSION=dev

# PostgreSQL runs in Japan in production. Applications never use the owner login.
DATABASE_URL=postgres://platform_api_login:platform_api_dev_only@127.0.0.1:5432/self_deepsearch?sslmode=disable
ADMIN_DATABASE_URL=postgres://platform:platform_dev_only@127.0.0.1:5432/self_deepsearch?sslmode=disable
PLATFORM_API_DATABASE_URL=postgres://platform_api_login:platform_api_dev_only@127.0.0.1:5432/self_deepsearch?sslmode=disable
PLATFORM_WORKER_DATABASE_URL=postgres://platform_worker_login:platform_worker_dev_only@127.0.0.1:5432/self_deepsearch?sslmode=disable
POSTGRES_DB=self_deepsearch
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_dev_only
PLATFORM_API_DB_PASSWORD=platform_api_dev_only
PLATFORM_WORKER_DB_PASSWORD=platform_worker_dev_only

API_ADDR=:8080
WORKER_ADDR=:8081
WORKER_REGION=japan
WORKER_ID=japan-worker-1
COLLECTION_ENABLED=false
WORKER_POLL_INTERVAL=2s
WORKER_LEASE_DURATION=30s

# One-time deployment command input. Set only for the create-owner invocation.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

DISPLAY_WEB_ORIGIN=http://127.0.0.1:3000
OPS_WEB_ORIGIN=http://127.0.0.1:3001
PLATFORM_API_URL=http://127.0.0.1:8080
SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
RIGHTS_CONTACT_EMAIL=rights@example.invalid

# Real credentials stay outside Git. M0 uses disabled/fake providers.
SESSION_SECRET=
AUTH_HMAC_SECRET=
INGEST_HMAC_SECRET=
CACHE_HMAC_SECRET=
DISPLAY_REVALIDATE_URL=http://display-web:3000/api/internal/revalidate
MEDIA_HMAC_SECRET=
MEDIA_DELETE_URL=http://media-python:8090/v1/delete
MEDIA_RECONCILE_ENABLED=false
MEDIA_RECONCILE_URL=http://media-python:8090/v1/reconcile
MEDIA_RECONCILE_INTERVAL=24h
# Fixed daily publication/default image inspection; no external requests while disabled.
MEDIA_INSPECT_ENABLED=false
MEDIA_INSPECT_DISPLAY_ORIGIN=http://display-web:3000
# off | observe; observation only, not automatic delivery enforcement.
# Explicit account period: start inclusive, end exclusive, RFC3339 UTC.
MEDIA_USAGE_MONITOR_MODE=off
# Explicitly gates scheduled full reconciliation only; requires observe + reconciliation.
MEDIA_RECONCILE_USAGE_GUARD=off
MEDIA_USAGE_PERIOD_START=
MEDIA_USAGE_PERIOD_END=
MEDIA_USAGE_INTERVAL=15m
R2_ANALYTICS_ACCOUNT_ID=
R2_ANALYTICS_API_TOKEN=
SMTP_URL=
EMAIL_DAILY_LIMIT=500
EMAIL_FAILURE_THRESHOLD=5
EMAIL_CIRCUIT_COOLDOWN=15m
EMAIL_SEND_TIMEOUT=10s
TURNSTILE_BYPASS=true
TRUST_PROXY_HEADERS=false
METRICS_TOKEN=
METRICS_TOKEN_FILE=
HISTORY_ARCHIVE_ENABLED=false
HISTORY_ARCHIVE_DIR=/var/lib/self-deepsearch/history-archives
HISTORY_ARCHIVE_INTERVAL=6h
HISTORY_ARCHIVE_MIN_AGE=720h
HISTORY_ARCHIVE_BATCH_SIZE=1000
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=127.0.0.1
S3_ENDPOINT_URL=
S3_REGION=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
S3_PUBLIC_BASE_URL=
MEDIA_STORAGE_LIMIT_BYTES=10737418240
# normal | default_only (manual emergency mode; not automatic quota accounting)
MEDIA_DELIVERY_MODE=normal
# off | enforce. In enforce mode API/Next read the durable usage state for each
# catalog/document request and fail closed to default images on stale/error state.
MEDIA_DELIVERY_DYNAMIC_MODE=off
# off | enforce. Exposes one bearer-protected policy endpoint only for the
# Cloudflare media gateway. Keep the independent token empty while off.
MEDIA_EDGE_POLICY_MODE=off
MEDIA_EDGE_POLICY_TOKEN=
# All Beijing upload commands must use this same persistent volume/path.
MEDIA_UPLOAD_LOCK_FILE=/var/lib/self-deepsearch/media-state/upload.lock
# Optional runtime upload control. Enable only after every Beijing uploader is upgraded.
MEDIA_UPLOAD_CONTROL_MODE=off
MEDIA_UPLOAD_CONTROL_URL=http://media-python:8090
MEDIA_UPLOAD_CONTROL_SECRET=
# Optional Japan queue executor. Does not auto-create usage-policy commands.
MEDIA_UPLOAD_QUEUE_MODE=off
MEDIA_UPLOAD_CONTROL_ALLOW_HTTP=false
# Per-operation usage admission. Requires observe + dispatch in Japan and control enforce in Beijing.
# Use a fixed IP reachable through TLS/VPN; never a browser/public API URL.
MEDIA_UPLOAD_ADMISSION_MODE=off
MEDIA_UPLOAD_ADMISSION_URL=
MEDIA_UPLOAD_ADMISSION_SECRET=
MEDIA_UPLOAD_ADMISSION_ALLOW_HTTP=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
