APP_ENV=production
BUILD_VERSION=replace-with-release-version

PLATFORM_API_IMAGE=registry.example.invalid/self-deepsearch/platform-api:replace-with-immutable-tag
PLATFORM_WORKER_IMAGE=registry.example.invalid/self-deepsearch/platform-worker:replace-with-immutable-tag
DISPLAY_WEB_IMAGE=registry.example.invalid/self-deepsearch/display-web:replace-with-immutable-tag
OPS_WEB_IMAGE=registry.example.invalid/self-deepsearch/ops-web:replace-with-immutable-tag
EDGE_IMAGE=nginx:1.27.5-alpine

DISPLAY_HOST=display.example.invalid
API_HOST=api.example.invalid
OPS_HOST=ops.example.invalid
ORIGIN_CERT_FILE=/srv/self-deepsearch/secrets/cloudflare-origin.crt
ORIGIN_KEY_FILE=/srv/self-deepsearch/secrets/cloudflare-origin.key

POSTGRES_DB=self_deepsearch
POSTGRES_USER=platform
POSTGRES_PASSWORD=replace-with-random-database-password
ADMIN_DATABASE_URL=postgres://platform:replace-with-url-encoded-owner-password@postgres:5432/self_deepsearch?sslmode=disable
PLATFORM_API_DB_PASSWORD=replace-with-different-api-password
PLATFORM_WORKER_DB_PASSWORD=replace-with-different-worker-password
PLATFORM_API_DATABASE_URL=postgres://platform_api_login:replace-with-url-encoded-api-password@postgres:5432/self_deepsearch?sslmode=disable
PLATFORM_WORKER_DATABASE_URL=postgres://platform_worker_login:replace-with-url-encoded-worker-password@postgres:5432/self_deepsearch?sslmode=disable
BOOTSTRAP_OWNER_EMAIL=owner@example.invalid
BOOTSTRAP_OWNER_PASSWORD=replace-with-one-time-owner-password
ALLOW_SYNTHETIC_FIXTURES=false
CONFIRM_SYNTHETIC_FIXTURES=disabled

API_ADDR=:8080
WORKER_ADDR=:8081
WORKER_ID=japan-worker-1
WORKER_POLL_INTERVAL=2s
WORKER_LEASE_DURATION=30s
ALLOWED_ORIGINS=https://display.example.invalid,https://ops.example.invalid
PLATFORM_API_URL=http://platform-api:8080
SITE_URL=https://display.example.invalid
NEXT_PUBLIC_SITE_URL=https://display.example.invalid
RIGHTS_CONTACT_EMAIL=rights@example.invalid
S3_PUBLIC_BASE_URL=https://media.example.invalid
MEDIA_DELIVERY_MODE=normal
# off | enforce. Requires MEDIA_USAGE_MONITOR_MODE=observe and a fresh,
# explicitly configured usage period. Manual default_only remains authoritative.
MEDIA_DELIVERY_DYNAMIC_MODE=off
# Enable only after the private R2-bound Cloudflare media gateway is deployed.
MEDIA_EDGE_POLICY_MODE=off
MEDIA_EDGE_POLICY_TOKEN=

AUTH_HMAC_SECRET=replace-with-at-least-32-random-bytes
CACHE_HMAC_SECRET=replace-with-a-different-at-least-32-byte-random-value
DISPLAY_REVALIDATE_URL=http://display-web:3000/api/internal/revalidate
MEDIA_DELETE_URL=http://replace-with-beijing-private-ip:8090/v1/delete
MEDIA_HMAC_SECRET=replace-with-a-third-at-least-32-byte-random-value
# Optional one-shot upload control origin and separate secret (no automatic scheduler).
MEDIA_UPLOAD_CONTROL_URL=
MEDIA_UPLOAD_CONTROL_SECRET=
MEDIA_UPLOAD_QUEUE_MODE=off
MEDIA_UPLOAD_CONTROL_ALLOW_HTTP=false
# Private per-operation admission on the existing Worker listener. See docs/MEDIA_UPLOAD_ADMISSION.md.
# Requires observe + dispatch and a separate matching secret in Beijing. No public route by default.
MEDIA_UPLOAD_ADMISSION_MODE=off
MEDIA_UPLOAD_ADMISSION_SECRET=
MEDIA_RECONCILE_ENABLED=true
MEDIA_RECONCILE_URL=http://replace-with-beijing-private-ip:8090/v1/reconcile
MEDIA_RECONCILE_INTERVAL=24h
# Required for Release A deployment. Use SITE_URL for public-path evidence;
# an internal origin only verifies the origin server, not Cloudflare.
MEDIA_INSPECT_ENABLED=true
MEDIA_INSPECT_DISPLAY_ORIGIN=https://display.example.com
# off | observe. Requires schema v19; never guesses/rolls over the billing period.
# Use account-scoped read-only Analytics credentials, NOT the purge/edit token.
MEDIA_USAGE_MONITOR_MODE=off
# Stops new full scans on high/stale/review state, not uploads or image delivery.
MEDIA_RECONCILE_USAGE_GUARD=off
MEDIA_USAGE_PERIOD_START=
MEDIA_USAGE_PERIOD_END=
MEDIA_USAGE_INTERVAL=15m
R2_ANALYTICS_ACCOUNT_ID=
R2_ANALYTICS_API_TOKEN=
SMTP_URL=smtps://replace-with-provider-credentials
EMAIL_DAILY_LIMIT=500
EMAIL_FAILURE_THRESHOLD=5
EMAIL_CIRCUIT_COOLDOWN=15m
EMAIL_SEND_TIMEOUT=10s
TURNSTILE_BYPASS=false
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
TURNSTILE_EXPECTED_HOSTNAME=display.example.invalid
TRUST_PROXY_HEADERS=true

METRICS_TOKEN=replace-with-at-least-32-random-bytes
METRICS_TOKEN_FILE=/srv/self-deepsearch/secrets/metrics_token
ALERTMANAGER_CONFIG_FILE=/srv/self-deepsearch/secrets/alertmanager.yml
ALERTMANAGER_SMTP_PASSWORD_FILE=/srv/self-deepsearch/secrets/alertmanager_smtp_password

HISTORY_ARCHIVE_ENABLED=false
HISTORY_ARCHIVE_DIR=/var/lib/self-deepsearch/history-archives
HISTORY_ARCHIVE_INTERVAL=6h
HISTORY_ARCHIVE_MIN_AGE=720h
HISTORY_ARCHIVE_BATCH_SIZE=1000

COLLECTION_ENABLED=false
