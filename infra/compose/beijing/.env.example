APP_ENV=production
BUILD_VERSION=replace-with-release-version

WORKER_ADDR=:8081
WORKER_ID=beijing-worker-1
WORKER_POLL_INTERVAL=2s
WORKER_LEASE_DURATION=30s
METRICS_TOKEN=replace-with-at-least-32-random-bytes

PLATFORM_WORKER_IMAGE=registry.example.invalid/self-deepsearch/platform-worker:replace-with-immutable-tag
MEDIA_PYTHON_IMAGE=registry.example.invalid/self-deepsearch/media-python:replace-with-immutable-tag
INGEST_API_URL=https://api.example.invalid/internal/v1/ingest

MEDIA_HMAC_SECRET=replace-with-the-same-media-secret-as-japan
S3_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_PRIVATE_BUCKET=replace-with-private-master-bucket
S3_PUBLIC_BUCKET=replace-with-public-derivative-bucket
S3_PUBLIC_BASE_URL=https://media.example.invalid
MEDIA_STORAGE_LIMIT_BYTES=10737418240
MEDIA_DELIVERY_MODE=normal
# Fixed shared admission path for every uploader in this Compose project.
MEDIA_UPLOAD_LOCK_FILE=/var/lib/self-deepsearch/media-state/upload.lock
# All uploaders must share the state volume. Missing control state pauses uploads in enforce mode.
MEDIA_UPLOAD_CONTROL_MODE=off
# Separate from MEDIA_HMAC_SECRET; must match Japan when enforce is enabled.
MEDIA_UPLOAD_CONTROL_SECRET=
# Requires Japan admission enforce and Beijing control enforce. Fixed IP origin only.
# HTTPS validates the IP certificate; HTTP requires a trusted encrypted tunnel and explicit opt-in.
MEDIA_UPLOAD_ADMISSION_MODE=off
MEDIA_UPLOAD_ADMISSION_URL=
MEDIA_UPLOAD_ADMISSION_SECRET=
MEDIA_UPLOAD_ADMISSION_ALLOW_HTTP=false
AWS_ACCESS_KEY_ID=replace-with-media-role-access-key
AWS_SECRET_ACCESS_KEY=replace-with-media-role-secret-key
CLOUDFLARE_ZONE_ID=replace-with-zone-id
CLOUDFLARE_API_TOKEN=replace-with-cache-purge-only-token
